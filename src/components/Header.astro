---
import { languages, ui, homeUrl, type Language } from '../i18n/ui';

interface Props { lang: Language; languagePath: (language: Language) => string }
const { lang, languagePath } = Astro.props;
const t = ui[lang];
const sections = ['projects', 'presentations', 'experience', 'about', 'contact'];
const onHome = Astro.url.pathname === homeUrl(lang);
---
<header class="site-header">
  <a class="wordmark" href={homeUrl(lang)} aria-label={`${t.name} — ${t.home}`}>sm<span>.dev</span></a>
  <nav class="navigation" aria-label={lang === 'ru' ? 'Главная навигация' : 'Main navigation'}>
    {t.navigation.map((label, index) => <a href={`${onHome ? '' : homeUrl(lang)}#${sections[index]}`} data-section-link={onHome ? sections[index] : undefined}>{label}</a>)}
  </nav>
  <nav class="language" aria-label={t.language}>
    {languages.map((language) => <a
      href={languagePath(language)}
      lang={language}
      hreflang={language}
      aria-current={language === lang ? 'page' : undefined}
      aria-label={language === 'ru' ? 'Русская версия' : 'English version'}
    >{language.toUpperCase()}</a>)}
  </nav>
</header>
