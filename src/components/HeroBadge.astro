---
import type { Language } from '../i18n/ui';
interface Props { lang: Language }
const { lang } = Astro.props;
---
<figure class="hero-badge">
  <div class="badge-stage" data-badge data-front="/images/portrait-badge.svg" data-back="/images/badge-back.svg">
    <img class="badge-fallback" src="/images/portrait-badge.svg" width="480" height="680" alt={lang === 'ru' ? 'Бейдж с фотографией Сергея Мотынги' : 'Badge with a portrait of Sergey Motynga'} />
  </div>
</figure>
