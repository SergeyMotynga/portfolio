---
import { ui, projectUrl, type Language } from '../i18n/ui';
import type { Project } from '../lib/projects';
import TextEffect from './TextEffect.astro';
import '../styles/showcase.css';
interface Props { project: Project; index: number; lang: Language; compact?: boolean }
const { project, index, lang, compact = false } = Astro.props;
const { data } = project;
const t = ui[lang];
---
<article class:list={['project-row', 'project-card', { compact }]} id={`project-${data.key}`} data-card data-reveal="up" data-sequence={index - 1}>
  <div class="card-tilt"><div class="card-rotor">
    <div class="card-face card-front" data-card-front>
      <div class="card-eyebrow"><span class="category">{t.categories[data.category]}</span><span class="project-index">{String(index).padStart(2, '0')}</span></div>
      <div class="project-cover" aria-hidden="true"><img src={`/images/projects/${data.key}.svg`} alt="" width="720" height="360" loading="lazy" decoding="async" /></div>
      <h3 class="project-title">{data.title}</h3><p class="project-description"><TextEffect text={data.summary} /></p>
      <ul class="card-preview-stack" aria-label={t.stack}>{data.stack.slice(0, 3).map((technology) => <li>{technology}</li>)}</ul>
      <div class="card-actions"><button type="button" class="card-flip icon-control" data-card-flip aria-label={`${lang === 'ru' ? 'Подробнее о проекте' : 'More about'}: ${data.title}`} hidden>{lang === 'ru' ? 'Подробнее' : 'Details'}</button><a class="text-link" href={projectUrl(lang, data.key)}><span class="link-label">{t.case}</span> <span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="card-face card-back" data-card-back>
      <h3 class="card-back-title">{data.title}</h3><p>{data.contribution}</p>
      <ul class="stack-list" aria-label={t.stack}>{data.stack.map((technology) => <li>{technology}</li>)}</ul>
      <div class="card-actions"><button type="button" class="card-flip icon-control" data-card-flip aria-label={lang === 'ru' ? 'Вернуть обзор проекта' : 'Show project overview'} hidden>{lang === 'ru' ? 'Назад' : 'Back'}</button><a class="text-link" href={projectUrl(lang, data.key)}><span class="link-label">{t.case}</span> <span aria-hidden="true">↗</span></a></div>
      {data.repository && <a class="text-link" href={data.repository} target="_blank" rel="noopener noreferrer"><span class="link-label">{t.repository}</span> <span aria-hidden="true">↗</span></a>}
    </div>
  </div><span class="card-glare" aria-hidden="true"></span></div>
</article>
