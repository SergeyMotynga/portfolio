---
import { ui, projectUrl, type Language } from '../i18n/ui';
import type { Project } from '../lib/projects';

interface Props { project: Project; index: number; lang: Language; compact?: boolean }
const { project, index, lang, compact = false } = Astro.props;
const { data } = project;
const t = ui[lang];
---
<details class:list={['project-row', { compact }]} id={`project-${data.key}`} data-reveal="left" data-sequence={index - 1}>
  <summary>
    <span class="project-index" aria-hidden="true">{String(index).padStart(2, '0')}</span>
    <span class="project-summary">
      <span class="project-title">{data.title}</span>
      <span class="project-description">{data.summary}</span>
    </span>
    <span class="project-meta">
      <span class="category">{t.categories[data.category]}</span>
      <span class="technology">{data.stack.slice(0, 2).join(' / ')}</span>
    </span>
    <span class="row-arrow" aria-hidden="true">↗</span>
  </summary>
  <div class="project-expanded">
    <p class="micro">{t.contribution}</p>
    <p>{data.contribution}</p>
    <ul class="stack-list" aria-label={t.stack}>{data.stack.map((technology) => <li>{technology}</li>)}</ul>
    <a class="text-link" href={projectUrl(lang, data.key)}>{t.case} <span aria-hidden="true">↗</span></a>
    {data.repository && <a class="text-link repository-link" href={data.repository} target="_blank" rel="noopener noreferrer">{t.repository} <span aria-hidden="true">↗</span></a>}
  </div>
</details>
