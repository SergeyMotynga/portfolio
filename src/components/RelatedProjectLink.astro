---
import { projectUrl, ui, type Language } from '../i18n/ui';

interface Props { lang: Language; projectKey: string; title: string }
const { lang, projectKey, title } = Astro.props;
---
<a class="related-project presentation-link" href={projectUrl(lang, projectKey)}>
  <span class="related-project-name">{title}</span>
  <span class="text-link" aria-hidden="true"><span class="link-label">{ui[lang].viewRelatedProject}</span> <span aria-hidden="true">↗</span></span>
</a>
<style>
  .related-project {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    column-gap: 20px;
    padding: 8px 16px;
    border-block: 1px solid var(--line);
    background-color: color-mix(in srgb, var(--surface) 55%, transparent);
  }
  .related-project > .text-link { color: var(--accent); }
  .related-project > .text-link > span[aria-hidden='true'] { color: inherit; }
  @media (hover: hover) {
    .related-project:hover { background-color: var(--surface); }
    .related-project:hover > .related-project-name { color: var(--accent); }
  }
</style>
