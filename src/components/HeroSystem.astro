---
import type { Language } from '../i18n/ui';
interface Props { lang: Language }
const { lang } = Astro.props;
const t = lang === 'ru' ? {
  title: 'От запроса к ответу', request: 'Запрос', response: 'Ответ',
  description: 'Запрос поступает в API-слой, проходит через сервисный слой к базе данных. Результат возвращается через сервисный и API-слои в ответе.',
  layers: [
    ['API-слой', 'Проверка запроса и маршрутизация'],
    ['Сервисный слой', 'Бизнес-правила и операции'],
    ['Слой БД', 'Чтение и сохранение данных'],
  ],
} : {
  title: 'From request to response', request: 'Request', response: 'Response',
  description: 'A request enters the API layer and passes through the service layer to the database. The result returns through the service and API layers in a response.',
  layers: [
    ['API layer', 'Request validation and routing'],
    ['Service layer', 'Business rules and operations'],
    ['Database layer', 'Reading and persisting data'],
  ],
};
---
<figure class="hero-visual architecture" data-system>
  <figcaption class="architecture-title micro">{t.title}</figcaption>
  <div class="architecture-map" role="img" aria-label={t.description}>
    <div class="flow-terminals" aria-hidden="true"><span>{t.request} <b>↓</b></span><span><b>↑</b> {t.response}</span></div>
    <svg class="layer-connections" viewBox="0 0 600 36" preserveAspectRatio="none" aria-hidden="true">
      <path class="flow-in" d="M150 0V32m-4-4 4 4 4-4" /><path class="flow-out" d="M450 36V4m-4 4 4-4 4 4" />
    </svg>
    <ol class="architecture-layers" aria-hidden="true">
      {t.layers.map(([title, description], index) => <li>
        <div class:list={['layer-card', { 'layer-service': index === 1 }]}>
          <span class="layer-index">{String(index + 1).padStart(2, '0')}</span>
          <div><strong>{title}</strong><p>{description}</p></div>
          <span class="layer-port" aria-hidden="true">↔</span>
        </div>
        {index < t.layers.length - 1 && <svg class="layer-connections" viewBox="0 0 600 36" preserveAspectRatio="none" aria-hidden="true">
          <path class="flow-in" d="M150 0V32m-4-4 4 4 4-4" /><path class="flow-out" d="M450 36V4m-4 4 4-4 4 4" />
        </svg>}
      </li>)}
    </ol>
  </div>
</figure>
