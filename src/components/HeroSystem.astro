---
import type { Language } from '../i18n/ui';
interface Props { lang: Language }
const { lang } = Astro.props;
const t = lang === 'ru' ? {
  title: 'От запроса к результату', demo: 'Интерактивная схема',
  description: 'Демонстрация пути запроса через API, бизнес-логику и данные или ML. Можно выбрать сценарий; схема не обращается к серверу.',
  label: 'Выберите сценарий запроса', data: 'Данные', pause: 'Пауза', play: 'Продолжить', reduced: 'Движение уменьшено',
  request: 'Запрос', service: 'Бизнес-логика', response: 'Результат', caption: 'Авторизация → логика → сохранение',
} : {
  title: 'From request to result', demo: 'Interactive diagram',
  description: 'An illustration of a request passing through an API, business logic, and data or ML. Choose a scenario; the diagram does not call a server.',
  label: 'Choose a request scenario', data: 'Data', pause: 'Pause', play: 'Resume', reduced: 'Reduced motion',
  request: 'Request', service: 'Business logic', response: 'Result', caption: 'Authentication → logic → persistence',
};
---
<div class="hero-visual" data-system data-scene="api" data-motion="paused" data-language={lang}>
  <div class="system-console">
    <div class="console-heading"><span class="micro">{t.demo}</span><span class="console-lights" aria-hidden="true"><i></i><i></i><i></i></span></div>
    <div class="system-diagram" role="img" aria-label={t.description}>
      <svg class="system-wires" viewBox="0 0 1000 600" preserveAspectRatio="none" aria-hidden="true">
        <path class="wire wire-entry" d="M500 60 C500 160 160 120 160 260" />
        <path class="wire wire-core" d="M160 260 H500" />
        <path class="wire wire-data" d="M500 260 C650 260 650 160 840 160" />
        <path class="wire wire-ml" d="M500 260 C650 260 650 380 840 380" />
        <path class="wire wire-data-return" d="M840 160 V470 Q840 530 500 530" />
        <path class="wire wire-ml-return" d="M840 380 V470 Q840 530 500 530" />
      </svg>
      <div class="system-node node-request"><span class="node-dot" aria-hidden="true"></span><span data-request-label>POST /tasks</span></div>
      <div class="system-node node-api"><span class="node-mini">01 / API</span><strong>FastAPI</strong></div>
      <div class="system-node node-core"><span class="node-mini">02 / CORE</span><strong>{t.service}</strong></div>
      <div class="system-node node-data"><span class="node-mini">03 / DATA</span><strong>PostgreSQL</strong></div>
      <div class="system-node node-ml"><span class="node-mini">03 / ML</span><strong>ML pipeline</strong></div>
      <div class="system-node node-result"><span class="node-dot" aria-hidden="true"></span><span>{t.response}</span><span aria-hidden="true">↗</span></div>
    </div>
    <p class="system-title">{t.title}</p>
    <p class="system-caption" data-system-caption aria-live="polite">{t.caption}</p>
    <div class="system-controls" hidden>
      <div class="scene-controls" role="group" aria-label={t.label}>
        <button type="button" data-scene-button="api" aria-pressed="true">API</button>
        <button type="button" data-scene-button="data" aria-pressed="false">{t.data}</button>
        <button type="button" data-scene-button="ml" aria-pressed="false">ML</button>
      </div>
      <button type="button" class="motion-toggle" data-motion-toggle data-pause-label={t.pause} data-play-label={t.play} data-reduced-label={t.reduced} aria-pressed="true">{t.play}</button>
    </div>
  </div>
</div>
