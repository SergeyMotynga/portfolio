---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, homeUrl, projectUrl, type Language } from '../i18n/ui';
import '../styles/global.css';
import '../styles/showcase.css';
import '../styles/scenes.css';

interface Props { lang: Language; title?: string; description?: string; projectKey?: string }
const { lang, title, description = ui[lang].description, projectKey } = Astro.props;
const pageTitle = title ? `${title} — ${ui[lang].name}` : `${ui[lang].name} — Python Backend Developer`;
const path = projectKey ? projectUrl(lang, projectKey) : homeUrl(lang);
const canonical = Astro.site ? new URL(path, Astro.site) : undefined;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111018" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    {canonical && <link rel="canonical" href={canonical} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {(['ru', 'en'] as const).map((language) => <link rel="alternate" hreflang={language} href={projectKey ? projectUrl(language, projectKey) : homeUrl(language)} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body id="top" class:list={{ 'case-view': Boolean(projectKey) }}>
    <div class="ambient-background" aria-hidden="true"><div class="silk-background" data-silk></div></div>
    <div class="scroll-progress" aria-hidden="true"></div>
    <a class="skip-link" href="#content">{ui[lang].skip}</a>
    <div class="site-shell">
      <Header lang={lang} projectKey={projectKey} />
      <main id="content"><slot /></main>
      <Footer lang={lang} />
    </div>
    <script>import '../scripts/motion';</script>
  </body>
</html>
