---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { languages, ui, homeUrl, projectUrl, type Language } from '../../../i18n/ui';
import { getProjects, type Project } from '../../../lib/projects';

export async function getStaticPaths() {
  return (await Promise.all(languages.map(async (lang) => (await getProjects(lang)).map((project) => ({
    params: { lang, key: project.data.key }, props: { lang, project },
  }))))).flat();
}
interface Props { lang: Language; project: Project }
const { lang, project } = Astro.props;
const { data } = project;
const t = ui[lang];
const { Content } = await render(project);
const projects = await getProjects(lang);
const current = projects.findIndex(({ data: item }) => item.key === data.key);
const next = projects[(current + 1) % projects.length];
---
<BaseLayout lang={lang} title={data.title} description={data.summary} projectKey={data.key}>
  <article class="case-page" data-project={data.key} data-disclosure={data.disclosure}>
    <a class="back-link" href={`${homeUrl(lang)}#projects`}><span aria-hidden="true">←</span> {t.back}</a>
    <header class="case-header">
      <p class="micro">{t.categories[data.category]} · Python / Software Engineering</p>
      <h1>{data.title}</h1>
      <p class="case-lead">{data.summary}</p>
      <ul class="stack-list" aria-label={t.stack}>{data.stack.map((technology) => <li>{technology}</li>)}</ul>
      {data.disclosure !== 'open' && <p class="disclosure-note">{data.disclosure === 'restricted' ? t.restricted : t.protected}</p>}
      {data.repository && <a class="text-link" href={data.repository} target="_blank" rel="noopener noreferrer"><span class="link-label">{t.repository}</span> <span aria-hidden="true">↗</span></a>}
    </header>
    <div class="prose"><h2>{t.contribution}</h2><p>{data.contribution}</p><Content /></div>
    <nav class="case-bottom" aria-label={lang === 'ru' ? 'Другие проекты' : 'Other projects'}>
      <a class="text-link" href={`${homeUrl(lang)}#projects`}><span aria-hidden="true">←</span> <span class="link-label">{t.back}</span></a>
      {next && <a class="next-project" href={projectUrl(lang, next.data.key)}><span class="micro">{t.nextProject}</span><span>{next.data.title} ↗</span></a>}
    </nav>
  </article>
</BaseLayout>
