---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import RelatedProjectLink from '../../../components/RelatedProjectLink.astro';
import { experience } from '../../../data/profile';
import { languages, ui, homeUrl, type Language } from '../../../i18n/ui';
import { getProjects } from '../../../lib/projects';

export function getStaticPaths() {
  return languages.flatMap((lang) => experience.map((entry) => ({
    params: { lang, key: entry.key }, props: { lang, entry },
  })));
}

interface Props { lang: Language; entry: (typeof experience)[number] }
const { lang, entry } = Astro.props;
const { company, contribution, description, period, highlights } = entry[lang];
const t = ui[lang];
const back = `${homeUrl(lang)}#experience`;
const projects = await getProjects(lang);
const related = entry.projects.map((key) => {
  const project = projects.find(({ data }) => data.key === key);
  if (!project) throw new Error(`Missing experience project: ${entry.key}/${key}/${lang}`);
  return project.data;
});
---
<BaseLayout lang={lang} title={company} description={description} detail={{ section: 'experience', key: entry.key }}>
  <article class="case-page" data-experience={entry.key}>
    <a class="back-link" href={back}><span aria-hidden="true">←</span> {t.backToExperience}</a>
    <header class="case-header">
      <p class="micro">{t.experience}</p>
      <h1>{company}</h1>
      <p class="case-lead">{contribution}</p>
      <p class="experience-period">{period}</p>
    </header>
    <div class="prose">
      <h2>{t.myWork}</h2>
      <p>{description}</p>
      <ul class="experience-highlights">{highlights.map((highlight) => <li>{highlight}</li>)}</ul>
      <section aria-labelledby="related-projects-title">
        <h2 id="related-projects-title">{t.relatedProjects}</h2>
        <ul class="related-projects">
          {related.map(({ key, title }) => <li><RelatedProjectLink lang={lang} projectKey={key} title={title} /></li>)}
        </ul>
      </section>
    </div>
    <nav class="case-bottom" aria-label={t.backToExperience}>
      <a class="text-link" href={back}><span aria-hidden="true">←</span> <span class="link-label">{t.backToExperience}</span></a>
    </nav>
  </article>
</BaseLayout>
<style>
  .experience-highlights { margin-block-start: 14px; }
  .related-projects { display: grid; gap: 8px; list-style: none; padding: 0; }
  .related-projects > li + li { margin: 0; }
</style>
