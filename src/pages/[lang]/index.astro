---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import HeroSystem from '../../components/HeroSystem.astro';
import MotionHeading from '../../components/MotionHeading.astro';
import { languages, ui, projectUrl, type Language } from '../../i18n/ui';
import { getProjects } from '../../lib/projects';
import { profile, skills, presentations } from '../../data/profile';

export function getStaticPaths() { return languages.map((lang) => ({ params: { lang }, props: { lang } })); }
interface Props { lang: Language }
const { lang } = Astro.props;
const t = ui[lang];
const projects = await getProjects(lang);
const featured = projects.filter(({ data }) => data.featured);
const catalog = projects.filter(({ data }) => !data.featured);
const resume = profile.resume?.[lang];
---
<BaseLayout lang={lang}>
  <section class="hero" aria-labelledby="hero-title">
    <p class="eyebrow micro"><span class="status-dot" aria-hidden="true"></span>Python backend · ML Engineering</p>
    <div class="hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title" class="hero-title-motion" aria-label={t.name}><span class="name-mask" aria-hidden="true"><span class="name-line">{t.name.split(' ')[0]}</span></span><span class="name-mask" aria-hidden="true"><span class="name-line">{t.name.split(' ').slice(1).join(' ')}</span></span></h1>
        <p class="hero-role">Python Backend Developer <span>/ ML Engineering</span></p>
        <p class="hero-lead">{t.lead}</p>
        <div class="hero-actions">
          <a class="primary-link" href="#projects">{t.explore} <span aria-hidden="true">↘</span></a>
          <a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
          {resume && <a class="text-link" href={resume} download>{t.resume} <span aria-hidden="true">↓</span></a>}
        </div>
      </div>
      <HeroSystem lang={lang} />
    </div>
    <ul class="tech-strip" aria-label={lang === 'ru' ? 'Основной стек' : 'Core stack'}>{['Python', 'FastAPI', 'PostgreSQL', 'SQLAlchemy'].map((technology) => <li>{technology}</li>)}</ul>
  </section>

  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="section-heading"><MotionHeading id="projects-title" text={t.selected} /><p class="micro">{t.selectedMeta}</p></div>
    {featured.map((project, index) => <ProjectRow project={project} index={index + 1} lang={lang} />)}
    {catalog.length > 0 && <details class="catalog">
      <summary><span>{t.catalog}</span><span class="catalog-count">{t.more} {catalog.length} <span aria-hidden="true">↗</span></span></summary>
      <div>{catalog.map((project, index) => <ProjectRow project={project} index={featured.length + index + 1} lang={lang} compact />)}</div>
    </details>}
  </section>

  <section class="section" id="presentations" aria-labelledby="presentations-title">
    <div class="section-heading"><MotionHeading id="presentations-title" text={t.presentations} /><p class="micro">{t.presentationsMeta}</p></div>
    <div class="presentations-grid">{presentations.map((presentation, index) => {
      const text = presentation.labels[lang];
      return <article class="presentation" data-reveal={index % 2 ? 'right' : 'up'} data-sequence={index}>
        <p class="micro">{text.type}</p><h3>{text.title}</h3><p>{text.description}</p>
        <a class="text-link" href={projectUrl(lang, presentation.project)}>{t.project} <span aria-hidden="true">↗</span></a>
      </article>;
    })}</div>
  </section>

  <section class="section" id="about" aria-labelledby="about-title">
    <div class="section-heading"><MotionHeading id="about-title" text={t.about} /><p class="micro">{t.aboutMeta}</p></div>
    <div class="about-grid">
      <dl class="skills" data-reveal="left">{(Object.keys(skills) as (keyof typeof skills)[]).map((key) => <><dt>{t[key]}</dt><dd>{skills[key].join(' · ')}</dd></>)}<dt>{t.next}</dt><dd>{t.go}</dd></dl>
      <div class="education" data-reveal="right"><p class="micro">{t.education}</p><h3>{t.university}</h3><p>{t.programme}</p><p>{t.educationText}</p></div>
    </div>
  </section>

  <section class="contact-section" id="contact" aria-labelledby="contact-title" data-reveal="up">
    <div><MotionHeading id="contact-title" text={t.contact} /><p>{t.contactText}</p></div>
    <div class="contact-links">
      {profile.email && <a class="text-link" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a>}
      {profile.telegram && <a class="text-link" href={profile.telegram} target="_blank" rel="noopener noreferrer">Telegram <span aria-hidden="true">↗</span></a>}
      <a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</BaseLayout>
